# Copy to .env and change every value marked CHANGE_ME. Never commit .env.
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FDE_JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
# Keyed hash for device fingerprints and payee references. Keep it stable: changing it
# makes every known device and payee look new to the model.
FDE_PSEUDONYM_SECRET=CHANGE_ME_another_32_random_characters_long
FDE_ENV=development
# Behind plain http://localhost the refresh cookie cannot be "Secure". Set true in production (HTTPS).
FDE_COOKIE_SECURE=false
FDE_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
FDE_LOG_LEVEL=INFO
FDE_LOG_JSON=true
# Used by `python -m app.cli demo` for the demo users (admin@example.com, lead@, analyst@, analyst2@, auditor@).
FDE_ADMIN_PASSWORD=CHANGE_ME_demo_password
# Optional: store model artifacts and CSV uploads in S3 instead of the local volume (AWS deployment).
# FDE_ARTIFACT_S3_BUCKET=
